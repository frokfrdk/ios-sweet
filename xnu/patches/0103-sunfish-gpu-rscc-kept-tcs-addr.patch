+/*
+ * gmu_set for a register boot firmware may have set and write-protected: a write that
+ * leaves the old value in place is accepted and logged; any other readback still fails.
+ */
+static bool
+gmu_set_or_kept(const char *name, uint32_t reg, uint32_t val)
+{
+	uint32_t old = gmu_rd(gm_gmu, reg);
+	gmu_wr(gm_gmu, reg, val);
+	uint32_t got = gmu_rd(gm_gmu, reg);
+	if (got != val && got == old) {
+		printf("SWEET GMU:   %-28s [0x%05x] = 0x%08x kept (wrote 0x%08x; firmware value, accepted)\n",
+		    name, reg, got, val);
+		return true;
+	}
+	printf("SWEET GMU:   %-28s [0x%05x] = 0x%08x%s\n", name, reg, got, got == val ? "" : " MISMATCH");
+	return got == val;
+}
