+bool
+sweet_gmu_gx_on(void)
+{
+	printf("SWEET GMU: 2B.4 GX rail through the GMU (gfx_rail_on), then SPTPRAC\n");
+	if (!gmu_votes()) {
+		printf("SWEET GMU: 2B.4 stopped: perf votes\n");
+		return false;
+	}
+	uint32_t vote = gm_gx_votes[GPU_LEVEL_START];
+	bool ok = gmu_set("BOOT_SLUMBER_OPTION", REG_A6XX_GMU_BOOT_SLUMBER_OPTION, 0);
+	ok = gmu_set("GX_VOTE_IDX", REG_A6XX_GMU_GX_VOTE_IDX, vote & 0xffu) && ok;
+	ok = gmu_set("MX_VOTE_IDX", REG_A6XX_GMU_MX_VOTE_IDX, (vote >> 8) & 0xffu) && ok;
+	if (!ok) {
+		printf("SWEET GMU: 2B.4 stopped: the DTCM mailbox did not read back\n");
+		return false;
+	}
+	gpu_pause("OOB boot_slumber: the GMU votes the GX rail on (HOST2GMU bit 22, ack bit 30)");
+	if (!gmu_oob_set(OOB_BOOT_SLUMBER, "boot_slumber")) {
+		sweet_gmu_status("after boot_slumber");
+		return false;
+	}
+	gpu_pause("SPTPRAC on (GMU_GX_SPTPRAC_POWER_CONTROL = 0x778000)");
+	uint32_t before = gmu_rd(gm_gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS);
+	gmu_wr(gm_gmu, REG_A6XX_GMU_GX_SPTPRAC_POWER_CONTROL, SPTPRAC_POWER_ON);
+	ok = gmu_wait(REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS, SPTPRAC_POWERON_STATUS, SPTPRAC_POWERON_STATUS,
+	    GMU_SPTPRAC_TIMEOUT_US);
+	printf("SWEET GMU:   SPTPRAC status 0x%08x -> 0x%08x: %s\n", before,
+	    gmu_rd(gm_gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS), ok ? "on" : "NOT ON in 10 ms");
+	sweet_gmu_status("after GX rail");
+	return ok;
+}
+
+/* The next message in the message queue into gm_rsp; its dwords, 0 if the queue is empty or bad. */
+static unsigned
+gmu_hfi_read(void)
+{
+	const uint32_t h = HFI_QHDR(HFI_MSG_Q), q = GMEM_HFI + HFI_QUEUE(HFI_MSG_Q);
+	uint32_t rd = mem_rd(h + 4u * QH_READ), wr = mem_rd(h + 4u * QH_WRITE);
+	if (rd == wr) {
+		return 0;
+	}
+	uint32_t size = rd < HFI_QUEUE_DWORDS ? (mem_rd(q + 4u * rd) >> 8) & 0xffu : 0;
+	if (wr >= HFI_QUEUE_DWORDS || size == 0) {
+		printf("SWEET GMU:   HFI message queue bad: read %u write %u size %u; emptied\n", rd, wr, size);
+		mem_wr(h + 4u * QH_READ, wr < HFI_QUEUE_DWORDS ? wr : 0);
+		return 0;
+	}
+	for (uint32_t i = 0; i < size; ++i) {
+		uint32_t w = mem_rd(q + 4u * ((rd + i) % HFI_QUEUE_DWORDS));
+		if (i < HFI_MSG_MAX) {
+			gm_rsp[i] = w;
+		}
+	}
+	mem_wr(h + 4u * QH_READ, (rd + size) % HFI_QUEUE_DWORDS);
+	return size;
+}
+
+/*
+ * hfi_send_cmd for HFI v1: gm_msg[1..dwords-1] is the body. Waits for the
+ * ack whose word 1 is our header; *payload gets its word 3. True if the GMU
+ * answered with error 0.
+ */
+static bool
+gmu_hfi_send(unsigned id, unsigned dwords, const char *name, uint32_t *payload)
+{
+	const uint32_t h = HFI_QHDR(HFI_CMD_Q), q = GMEM_HFI + HFI_QUEUE(HFI_CMD_Q);
+	const uint32_t hdr = id | dwords << 8 | HFI_MSG_CMD << 16 | (++gm_hfi_seq & 0xfffu) << 20;
+	gm_msg[0] = hdr;
+	uint32_t rd = mem_rd(h + 4u * QH_READ), wr = mem_rd(h + 4u * QH_WRITE);
+	uint32_t space = rd > wr ? rd - wr : HFI_QUEUE_DWORDS - wr + rd;
+	if (rd >= HFI_QUEUE_DWORDS || wr >= HFI_QUEUE_DWORDS || space <= dwords) {
+		printf("SWEET GMU:   HFI %s: command queue read %u write %u; no room\n", name, rd, wr);
+		return false;
+	}
+	for (unsigned i = 0; i < dwords; ++i) {
+		mem_wr(q + 4u * ((wr + i) % HFI_QUEUE_DWORDS), gm_msg[i]);
+	}
+	mem_wr(h + 4u * QH_WRITE, (wr + dwords) % HFI_QUEUE_DWORDS);
+	__asm__ volatile("dsb sy" ::: "memory");
+	gmu_wr(gm_gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET, 1);
+	for (unsigned t = 0; t < GMU_TIMEOUT_US; t += 10) {
+		if (!(gmu_rd(gm_gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO) & HFI_IRQ_MSGQ)) {
+			delay(10);
+			continue;
+		}
+		gmu_wr(gm_gmu, REG_A6XX_GMU_GMU2HOST_INTR_CLR, HFI_IRQ_MSGQ);
+		unsigned n;
+		while ((n = gmu_hfi_read())) {
+			if (((gm_rsp[0] >> 16) & 0xfu) != HFI_MSG_ACK || n < 3 || gm_rsp[1] != hdr) {
+				printf("SWEET GMU:   HFI %s: skipped message 0x%08x (%u dwords)\n", name, gm_rsp[0], n);
+				continue;
+			}
+			if (payload) {
+				*payload = n > 3 ? gm_rsp[3] : 0;
+			}
+			printf("SWEET GMU:   HFI %s (0x%08x): acked, error %u%s\n", name, hdr, gm_rsp[2],
+			    gm_rsp[2] ? " REJECTED" : "");
+			return gm_rsp[2] == 0;
+		}
+		delay(10);
+	}
+	printf("SWEET GMU:   HFI %s (0x%08x): NO ACK in 100 ms (cmd read %u write %u, msg read %u write %u)\n", name,
+	    hdr, mem_rd(h + 4u * QH_READ), mem_rd(h + 4u * QH_WRITE), mem_rd(HFI_QHDR(HFI_MSG_Q) + 4u * QH_READ),
+	    mem_rd(HFI_QHDR(HFI_MSG_Q) + 4u * QH_WRITE));
+	return false;
+}
+
+static void
+gmu_msg_clear(void)
+{
+	for (unsigned i = 0; i < HFI_MSG_MAX; ++i) {
+		gm_msg[i] = 0;
+	}
+}
