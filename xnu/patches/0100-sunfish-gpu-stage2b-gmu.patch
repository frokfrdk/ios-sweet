+bool
+sweet_gmu_survey(vm_offset_t gmu, uint64_t mem_pa, uint32_t mem_len)
+{
+	gm_gmu = gmu;
+	gm_mem_pa = mem_pa;
+	gm_mem_len = mem_len;
+	printf("SWEET GMU: 2B.0 survey: GPU SMMU, GMU, RSCC, PDC; nothing written\n");
+	gpu_pause("GPU SMMU survey (0x5040000)");
+	bool smmu = sweet_smmu_survey();
+	gpu_pause("GMU and RSCC register survey (0x506a000, 0x508d000)");
+	gmu_log_regs("GMU", gmu_survey_regs, sizeof(gmu_survey_regs) / sizeof(gmu_survey_regs[0]));
+	gmu_log_regs("RSCC", gmu_rscc_regs, sizeof(gmu_rscc_regs) / sizeof(gmu_rscc_regs[0]));
+	printf("SWEET GMU:   RSCC SEQ_MEM_0..4 %08x %08x %08x %08x %08x\n", gmu_rd(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0),
+	    gmu_rd(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 1u), gmu_rd(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 2u),
+	    gmu_rd(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 3u), gmu_rd(gmu, REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + 4u));
+	printf("SWEET GMU:   ITCM %08x %08x %08x %08x  DTCM %08x %08x %08x %08x\n",
+	    gmu_rd(gmu, REG_A6XX_GMU_CM3_ITCM_START), gmu_rd(gmu, REG_A6XX_GMU_CM3_ITCM_START + 1u),
+	    gmu_rd(gmu, REG_A6XX_GMU_CM3_ITCM_START + 2u), gmu_rd(gmu, REG_A6XX_GMU_CM3_ITCM_START + 3u),
+	    gmu_rd(gmu, REG_A6XX_GMU_CM3_DTCM_START), gmu_rd(gmu, REG_A6XX_GMU_CM3_DTCM_START + 1u),
+	    gmu_rd(gmu, REG_A6XX_GMU_CM3_DTCM_START + 2u), gmu_rd(gmu, REG_A6XX_GMU_CM3_DTCM_START + 3u));
+	gpu_pause("GPU PDC survey (cfg 0xb290000, seq 0xb490000; an always-on block, first EL1 access)");
+	if (!gm_pdc_cfg) {
+		gm_pdc_cfg = ml_io_map(PDC_CFG_PA, PDC_SIZE);
+	}
+	if (!gm_pdc_seq) {
+		gm_pdc_seq = ml_io_map(PDC_SEQ_PA, PDC_SIZE);
+	}
+	if (!gm_pdc_cfg || !gm_pdc_seq) {
+		printf("SWEET GMU: PDC mapping failed\n");
+		return false;
+	}
+	gmu_log_pdc(gm_pdc_cfg, gm_pdc_seq, "as found");
+	printf("SWEET GMU:   GPU-GMU-MEM pa %#llx len %#x (needs %#x)\n", mem_pa, mem_len, GMEM_USED);
+	return smmu;
+}
+
+/* Clean and invalidate to PoC through the kernel's cacheable mapping, before the uncached one takes over. */
+static void
+gmu_mem_flush(vm_offset_t va, uint32_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile("mrs %0, ctr_el0" : "=r"(ctr));
+	const vm_offset_t line = (vm_offset_t)4u << ((ctr >> 16) & 0xfu);
+	for (vm_offset_t p = va & ~(line - 1u); p < va + len; p += line) {
+		__asm__ volatile("dc civac, %0" :: "r"(p) : "memory");
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+bool
+sweet_gmu_mem(void)
+{
+	printf("SWEET GMU: 2B.1 GMU memory and an SMMU bank for streams %u-%u\n", GMU_STREAM, GMU_STREAM | GMU_STREAM_MASK);
+	if (!gm_mem_pa || gm_mem_len < GMEM_USED || (gm_mem_pa & 0xfffu)) {
+		printf("SWEET GMU: GPU-GMU-MEM missing or too small (mkboot.sh GPUFW=1, tools 0100+)\n");
+		return false;
+	}
+	gmu_mem_flush(ml_static_ptovirt(gm_mem_pa), gm_mem_len);
+	gpu_pause("uncached mapping of GPU-GMU-MEM (ml_io_map_wcomb of kernel RAM)");
+	gm_mem = ml_io_map_wcomb(gm_mem_pa, gm_mem_len);
+	if (!gm_mem) {
+		printf("SWEET GMU: uncached mapping failed\n");
+		return false;
+	}
+	unsigned nonzero = 0;
+	for (uint32_t off = 0; off < GMEM_USED; off += 4) {
+		nonzero += mem_rd(off) != 0;
+	}
+	printf("SWEET GMU:   mapped at %#lx, %u non-zero words in the used part\n", gm_mem, nonzero);
+	struct sweet_smmu_pt pt;
+	sweet_smmu_pt_init(&pt, gm_mem, gm_mem_pa, GMEM_PT_SIZE);
+	for (unsigned i = 0; i < sizeof(gmu_regions) / sizeof(gmu_regions[0]); ++i) {
+		printf("SWEET GMU:   %s\n", gmu_regions[i].name);
+		if (!sweet_smmu_map(&pt, gmu_regions[i].iova, gm_mem_pa + gmu_regions[i].off, gmu_regions[i].len)) {
+			return false;
+		}
+	}
+	gpu_pause("SMMU context bank and stream match for the GMU (0x5040000)");
+	gm_cb = sweet_smmu_attach(GMU_STREAM, GMU_STREAM_MASK, gm_mem_pa);
+	if (gm_cb < 0) {
+		return false;
+	}
+	return sweet_smmu_faults(gm_cb, "after attach") == 0;
+}
+
+/* _load_gmu_rpmh_ucode, a618 values. */
+static const struct {
+	const char *name;
+	uint32_t reg, val;
+} gmu_rscc_init[] = {
+	{ "RSC_STATUS0_DRV0", REG_A6XX_RSCC_RSC_STATUS0_DRV0, 1u << 24 },
+	{ "PDC_SLAVE_ID_DRV0", REG_A6XX_RSCC_PDC_SLAVE_ID_DRV0, 1 },
+	{ "HIDDEN_TCS_CMD0_ADDR", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR, 0 },
+	{ "HIDDEN_TCS_CMD0_DATA", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 1u, 0 },
+	{ "HIDDEN_TCS_CMD1_ADDR", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 2u, 0 },
+	{ "HIDDEN_TCS_CMD1_DATA", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 3u, 0 },
+	{ "HIDDEN_TCS_CMD2_ADDR", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 4u, 0 },
+	{ "HIDDEN_TCS_CMD2_DATA", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 5u, 0x80000000u },
+	{ "OVERRIDE_START_ADDR", REG_A6XX_RSCC_OVERRIDE_START_ADDR, 0 },
+	{ "PDC_SEQ_START_ADDR", REG_A6XX_RSCC_PDC_SEQ_START_ADDR, 0x4520 },
+	{ "PDC_MATCH_VALUE_LO", REG_A6XX_RSCC_PDC_MATCH_VALUE_LO, 0x4510 },
+	{ "PDC_MATCH_VALUE_HI", REG_A6XX_RSCC_PDC_MATCH_VALUE_HI, 0x4514 },
+};
+static const uint32_t gmu_rscc_seq[5] = { 0xa7a506a0u, 0xa1e6a6e7u, 0xa2e081e1u, 0xe9a982e2u, 0x0020e8a8u };
+static const uint32_t gmu_pdc_seq[5] = { 0xfebea1e1u, 0xa5a4a3a2u, 0x8382a6e0u, 0xbce3e284u, 0x002081fcu };
+/* PDC TCS commands: mx.lvl, cx.lvl, xo.lvl hlvl for TCS1 (power down) and TCS3 (power up) */
+static const char *const gmu_pdc_res[3] = { "mx.lvl", "cx.lvl", "xo.lvl" };
+static const uint32_t gmu_pdc_data[2][3] = { { 1, 0, 0 }, { 2, 2, 3 } };
+static const unsigned gmu_pdc_tcs[2] = { 1, 3 };
+
+static bool
+gmu_pdc_set(vm_offset_t base, uint32_t reg, uint32_t val)
+{
+	gpu_wr(base, reg * 4u, val);
+	uint32_t got = gpu_rd(base, reg * 4u);
+	if (got != val) {
+		printf("SWEET GMU:   PDC [0x%04x] reads 0x%08x, wrote 0x%08x: MISMATCH\n", reg, got, val);
+	}
+	return got == val;
+}
+
+bool
+sweet_gmu_rpmh(void)
+{
+	printf("SWEET GMU: 2B.2 TCM retention, RSCC and PDC microcode and TCS commands\n");
+	if (gm_cb < 0 || !gm_pdc_cfg || !gm_pdc_seq) {
+		printf("SWEET GMU: 2B.2 needs 2B.0 and 2B.1\n");
+		return false;
+	}
+	uint32_t addr[3];
+	for (unsigned i = 0; i < 3; ++i) {
+		if (gmu_cmddb(gmu_pdc_res[i], CMDDB_ARC, &addr[i], NULL, 0, NULL)) {
+			return false;
+		}
+	}
+	gpu_pause("GMU_GENERAL_7 = 1 (TCM retention), then the RSCC (0x508d000)");
+	bool ok = gmu_set("GENERAL_7", REG_A6XX_GMU_GENERAL_7, 1);
+	for (unsigned i = 0; i < sizeof(gmu_rscc_init) / sizeof(gmu_rscc_init[0]); ++i) {
+		ok = gmu_set(gmu_rscc_init[i].name, gmu_rscc_init[i].reg, gmu_rscc_init[i].val) && ok;
+	}
+	for (unsigned i = 0; i < 5; ++i) {
+		ok = gmu_set("RSCC SEQ_MEM", REG_A6XX_RSCC_SEQ_MEM_0_DRV0 + i, gmu_rscc_seq[i]) && ok;
+	}
+	if (!ok) {
+		printf("SWEET GMU: 2B.2 stopped: RSCC write did not read back\n");
+		return false;
+	}
+	gpu_pause("PDC sequencer and TCS1/TCS3 commands (0xb490000, 0xb290000)");
+	for (unsigned i = 0; i < 5; ++i) {
+		ok = gmu_pdc_set(gm_pdc_seq, i, gmu_pdc_seq[i]) && ok;
+	}
+	for (unsigned t = 0; t < 2; ++t) {
+		uint32_t b = PDC_TCS_CONTROL(gmu_pdc_tcs[t]);
+		ok = gmu_pdc_set(gm_pdc_cfg, b + PDC_TCS_ENABLE, 7) && ok;
+		ok = gmu_pdc_set(gm_pdc_cfg, b + PDC_TCS_WAIT, 0) && ok;
+		ok = gmu_pdc_set(gm_pdc_cfg, b, 0) && ok;
+		for (unsigned c = 0; c < 3; ++c) {
+			uint32_t r = b + PDC_TCS_CMD(c);
+			ok = gmu_pdc_set(gm_pdc_cfg, r, PDC_MSGID) && ok;
+			ok = gmu_pdc_set(gm_pdc_cfg, r + 1u, addr[c]) && ok;
+			ok = gmu_pdc_set(gm_pdc_cfg, r + 2u, gmu_pdc_data[t][c]) && ok;
+		}
+	}
+	ok = gmu_pdc_set(gm_pdc_cfg, PDC_SEQ_START_ADDR, 0) && ok;
+	ok = gmu_pdc_set(gm_pdc_cfg, PDC_ENABLE_PDC, PDC_ENABLE_VALUE) && ok;
+	gmu_log_pdc(gm_pdc_cfg, gm_pdc_seq, "after");
+	printf("SWEET GMU: 2B.2 %s\n", ok ? "done: every value reads back" : "stopped: a PDC write did not read back");
+	return ok;
+}
+
+static void
+gmu_hfi_table_init(void)
+{
+	static const uint32_t tbl[6] = { 0, 54, 6, 12, HFI_QUEUES, HFI_QUEUES };
+	for (uint32_t off = GMEM_HFI; off < GMEM_HFI + 0x5000u; off += 4) {
+		mem_wr(off, 0);
+	}
+	for (unsigned i = 0; i < 6; ++i) {
+		mem_wr(GMEM_HFI + 4u * i, tbl[i]);
+	}
+	for (unsigned q = 0; q < HFI_QUEUES; ++q) {
+		uint32_t h = HFI_QHDR(q);
+		mem_wr(h + 4u * QH_STATUS, hfi_queues[q].status);
+		mem_wr(h + 4u * QH_START, GMU_VA_HFI + HFI_QUEUE(q));
+		mem_wr(h + 4u * QH_TYPE, hfi_queues[q].type);
+		mem_wr(h + 4u * QH_SIZE, HFI_QUEUE_DWORDS);
+		mem_wr(h + 4u * QH_RX_WM, 1);
+		mem_wr(h + 4u * QH_TX_WM, 1);
+		mem_wr(h + 4u * QH_RX_REQ, 1);
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	gm_hfi_seq = 0;
+}
+
+/* Mainline's a6xx_rpmh_start; only with sweetgmursc=1, before the CM3 starts. */
+static bool
+gmu_rscc_start(void)
+{
+	gmu_wr(gm_gmu, REG_A6XX_GMU_RSCC_CONTROL_REQ, 1u << 1);
+	bool ack = gmu_wait(REG_A6XX_GMU_RSCC_CONTROL_ACK, 1u << 1, 1u << 1, GMU_RSCC_TIMEOUT_US);
+	bool idle = gmu_wait(REG_A6XX_RSCC_SEQ_BUSY_DRV0, 0xffffffffu, 0, GMU_RSCC_TIMEOUT_US);
+	gmu_wr(gm_gmu, REG_A6XX_GMU_RSCC_CONTROL_REQ, 0);
+	printf("SWEET GMU:   RSCC start: ack %s (0x%08x), sequencer %s (0x%08x)\n", ack ? "yes" : "NO",
+	    gmu_rd(gm_gmu, REG_A6XX_GMU_RSCC_CONTROL_ACK), idle ? "idle" : "BUSY",
+	    gmu_rd(gm_gmu, REG_A6XX_RSCC_SEQ_BUSY_DRV0));
+	return ack && idle;
+}
+
+void
+sweet_gmu_status(const char *when)
+{
+	if (!gm_gmu) {
+		return;
+	}
+	printf("SWEET GMU: %s: FW_INIT_RESULT 0x%08x FW_BUSY 0x%08x GMU2HOST 0x%08x AO_HOST_INT 0x%08x "
+	    "RPMH_POWER_STATE 0x%08x SPTPRAC 0x%08x HFI_STATUS 0x%08x\n", when,
+	    gmu_rd(gm_gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT), gmu_rd(gm_gmu, REG_A6XX_GMU_CM3_FW_BUSY),
+	    gmu_rd(gm_gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO), gmu_rd(gm_gmu, REG_A6XX_GMU_AO_HOST_INTERRUPT_STATUS),
+	    gmu_rd(gm_gmu, REG_A6XX_GPU_GMU_CX_GMU_RPMH_POWER_STATE),
+	    gmu_rd(gm_gmu, REG_A6XX_GMU_SPTPRAC_PWR_CLK_STATUS), gmu_rd(gm_gmu, REG_A6XX_GMU_HFI_CTRL_STATUS));
+	(void)sweet_smmu_faults(gm_cb, when);
+}
+
+bool
+sweet_gmu_boot(const uint8_t *fw, uint32_t len, bool rsc_start)
+{
+	printf("SWEET GMU: 2B.3 firmware in, CM3 start%s\n", rsc_start ? " (with the RSCC start handshake)" : "");
+	if (!gm_mem || gm_cb < 0) {
+		printf("SWEET GMU: 2B.3 needs 2B.1\n");
+		return false;
+	}
+	if (!fw || len != GMU_TCM_BYTES) {
+		printf("SWEET GMU: GPU-GMU is %u bytes, expected %u (16 KiB ITCM + 16 KiB DTCM)\n", len, GMU_TCM_BYTES);
+		return false;
+	}
+	uint32_t sysreset = gmu_rd(gm_gmu, REG_A6XX_GMU_CM3_SYSRESET);
+	if (!(sysreset & 1u)) {
+		printf("SWEET GMU: CM3_SYSRESET 0x%08x: the CM3 is already running; not loaded\n", sysreset);
+		return false;
+	}
+	gmu_hfi_table_init();
+	gpu_pause("firmware into the GMU ITCM and DTCM (0x506d000, 32 KiB)");
+	const unsigned words = len / 4u;
+	for (unsigned i = 0; i < words; ++i) {
+		gmu_wr(gm_gmu, REG_A6XX_GMU_CM3_ITCM_START + i, fw32(fw + 4u * i));
+	}
+	unsigned bad = 0, first = 0;
+	for (unsigned i = 0; i < words; ++i) {
+		if (gmu_rd(gm_gmu, REG_A6XX_GMU_CM3_ITCM_START + i) != fw32(fw + 4u * i) && !bad++) {
+			first = i;
+		}
+	}
+	printf("SWEET GMU:   %u words written, %u differ on read-back%s", words, bad, bad ? "" : "\n");
+	if (bad) {
+		printf(", first at word %u: 0x%08x, want 0x%08x\nSWEET GMU: 2B.3 stopped: TCM load\n", first,
+		    gmu_rd(gm_gmu, REG_A6XX_GMU_CM3_ITCM_START + first), fw32(fw + 4u * first));
+		return false;
+	}
+	gpu_pause("boot registers (HFI table, fence, chip id, log, power config)");
+	bool ok = gmu_set("CM3_FW_INIT_RESULT", REG_A6XX_GMU_CM3_FW_INIT_RESULT, 0);
+	ok = gmu_set("CM3_BOOT_CONFIG", REG_A6XX_GMU_CM3_BOOT_CONFIG, 2) && ok;
+	ok = gmu_set("HFI_QTBL_ADDR", REG_A6XX_GMU_HFI_QTBL_ADDR, GMU_VA_HFI) && ok;
+	ok = gmu_set("HFI_QTBL_INFO", REG_A6XX_GMU_HFI_QTBL_INFO, 1) && ok;
+	ok = gmu_set("AHB_FENCE_RANGE_0", REG_A6XX_GMU_AHB_FENCE_RANGE_0, 0x80a008a0u) && ok;
+	ok = gmu_set("CM3_CFG", REG_A6XX_GMU_CM3_CFG, 0x4052) && ok;
+	ok = gmu_set("HFI_SFR_ADDR", REG_A6XX_GMU_HFI_SFR_ADDR, 0x06018000u) && ok;   /* chip id 6.1.8.0 */
+	ok = gmu_set("PWR_COL_CP_MSG", REG_A6XX_GMU_PWR_COL_CP_MSG, GMU_VA_LOG) && ok;
+	ok = gmu_set("SYS_BUS_CONFIG", REG_A6XX_GMU_SYS_BUS_CONFIG, 1) && ok;
+	ok = gmu_set("ICACHE_CONFIG", REG_A6XX_GMU_ICACHE_CONFIG, 1) && ok;
+	ok = gmu_set("DCACHE_CONFIG", REG_A6XX_GMU_DCACHE_CONFIG, 1) && ok;
+	ok = gmu_set("PWR_COL_INTER_FRAME_CTRL", REG_A6XX_GMU_PWR_COL_INTER_FRAME_CTRL, 0x09c40400u) && ok;
+	ok = gmu_set("RPMH_CTRL", REG_A6XX_GMU_RPMH_CTRL, gmu_rd(gm_gmu, REG_A6XX_GMU_RPMH_CTRL) | 0xf11u) && ok;
+	ok = gmu_set("CX_GMU_WFI_CONFIG", REG_A6XX_GMU_CX_GMU_WFI_CONFIG, 0) && ok;
+	if (!ok) {
+		/* Downstream never reads these back; some may be write-only. The init result decides. */
+		printf("SWEET GMU:   a boot register reads back differently; going on\n");
+	}
+	if (rsc_start) {
+		gpu_pause("RSCC start handshake (sweetgmursc=1, mainline order)");
+		(void)gmu_rscc_start();
+	}
+	(void)sweet_smmu_faults(gm_cb, "before CM3 start");
+	gpu_pause("CM3 out of reset (CM3_SYSRESET = 0), wait up to 100 ms for the init result");
+	uint64_t t0 = mach_absolute_time();
+	gmu_wr(gm_gmu, REG_A6XX_GMU_CM3_SYSRESET, 0);
+	uint32_t v = 0;
+	bool done = false;
+	for (unsigned t = 0; t <= GMU_TIMEOUT_US && !done; t += 10) {
+		v = gmu_rd(gm_gmu, REG_A6XX_GMU_CM3_FW_INIT_RESULT);
+		done = v == GMU_INIT_DONE || (v & 0x1ffu) == 0x100u;
+		if (!done) {
+			delay(10);
+		}
+	}
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("SWEET GMU:   FW_INIT_RESULT 0x%08x after %llu us: %s\n", v, ns / 1000u,
+	    v == GMU_INIT_DONE ? "0xBABEFACE (downstream value)" : done ? "(v & 0x1ff) == 0x100 (newer firmware)" :
+	    "NO INIT RESULT");
+	sweet_gmu_status("after CM3 start");
+	printf("SWEET GMU:   dummy page %08x %08x, log page %08x %08x %08x %08x\n", mem_rd(GMEM_DUMMY),
+	    mem_rd(GMEM_DUMMY + 4u), mem_rd(GMEM_LOG), mem_rd(GMEM_LOG + 4u), mem_rd(GMEM_LOG + 8u),
+	    mem_rd(GMEM_LOG + 12u));
+	uint32_t faults = sweet_smmu_faults(gm_cb, "after CM3 start");
+	if (!done || faults) {
+		gmu_wr(gm_gmu, REG_A6XX_GMU_CM3_SYSRESET, 1);
+		printf("SWEET GMU: 2B.3 stopped: %s; CM3 back in reset (CM3_SYSRESET 0x%08x)\n",
+		    !done ? "no init result" : "SMMU fault latched", gmu_rd(gm_gmu, REG_A6XX_GMU_CM3_SYSRESET));
+		return false;
+	}
+	printf("SWEET GMU: 2B.3 done: the GMU firmware runs\n");
+	return true;
+}
