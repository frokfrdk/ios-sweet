+	{ "HIDDEN_TCS_CMD1_ADDR", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 2u },
+	{ "HIDDEN_TCS_CMD1_DATA", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 3u },
+	{ "HIDDEN_TCS_CMD2_ADDR", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 4u },
+	{ "HIDDEN_TCS_CMD2_DATA", REG_A6XX_RSCC_HIDDEN_TCS_CMD0_ADDR + 5u },
+	{ "PDC_SEQ_START_ADDR", REG_A6XX_RSCC_PDC_SEQ_START_ADDR },
+	{ "PDC_MATCH_VALUE_LO", REG_A6XX_RSCC_PDC_MATCH_VALUE_LO },
+	{ "PDC_MATCH_VALUE_HI", REG_A6XX_RSCC_PDC_MATCH_VALUE_HI },
