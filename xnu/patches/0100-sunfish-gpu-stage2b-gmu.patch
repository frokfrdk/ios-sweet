+/* Poll every 10 us for up to us microseconds until (reg & mask) == want. */
+static bool
+gmu_wait(uint32_t reg, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned t = 0; t < us; t += 10) {
+		if ((gmu_rd(gm_gmu, reg) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return (gmu_rd(gm_gmu, reg) & mask) == want;
