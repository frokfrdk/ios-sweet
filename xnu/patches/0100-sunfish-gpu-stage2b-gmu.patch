+	gpu_log_gx(cc, gmu, "as found", false);
+	int step = 0;
+	bool ok = sweet_gmu_survey(gmu, gpu_blobs[BLOB_GMU_MEM].pa, gpu_blobs[BLOB_GMU_MEM].len);
+	if (ok && gpu_gmu_stop >= 1) {
+		step = 1;
