+/* rpmh_arc_votes_init: the first primary level >= vlvl, then the first secondary level >= that. */
+static bool
+gmu_vote(const unsigned *pri, unsigned npri, const unsigned *sec, unsigned nsec, unsigned vlvl, uint32_t *vote)
+{
+	unsigned p = 0, s = 0;
+	while (p < npri && pri[p] < vlvl) {
+		++p;
+	}
+	if (p == npri) {
+		return false;
+	}
+	while (s < nsec && sec[s] < pri[p]) {
+		++s;
+	}
+	if (s == nsec) {
+		return false;
+	}
+	*vote = pri[p] << 16 | s << 8 | p;
+	return true;
+}
+
+static bool
+gmu_votes(void)
+{
+	if (gm_votes_ok) {
+		return true;
+	}
+	unsigned gfx[16], mx[16], cx[16], ngfx = 0, nmx = 0, ncx = 0;
+	uint32_t a;
+	if (gmu_cmddb("gfx.lvl", CMDDB_ARC, &a, gfx, 16, &ngfx) || gmu_cmddb("mx.lvl", CMDDB_ARC, &a, mx, 16, &nmx) ||
+	    gmu_cmddb("cx.lvl", CMDDB_ARC, &a, cx, 16, &ncx)) {
+		return false;
+	}
+	bool ok = true;
+	for (unsigned i = 0; i < GPU_LEVELS; ++i) {
+		if (!gmu_vote(gfx, ngfx, mx, nmx, gpu_level_vlvl[i], &gm_gx_votes[i])) {
+			gm_gx_votes[i] = 0xffffffffu;
+		}
+		printf("SWEET GMU:   GPU perf %u: %6u kHz vlvl %3u vote 0x%08x%s\n", i, gpu_level_khz[i], gpu_level_vlvl[i],
+		    gm_gx_votes[i], gm_gx_votes[i] == gpu_level_vote_want[i] ? "" : " DIFFERS FROM THE PLAN");
+		ok = ok && gm_gx_votes[i] == gpu_level_vote_want[i];
+	}
+	for (unsigned i = 0; i < GMU_LEVELS; ++i) {
+		if (!gmu_vote(cx, ncx, mx, nmx, gmu_level_vlvl[i], &gm_cx_votes[i])) {
+			gm_cx_votes[i] = 0xffffffffu;
+		}
+		printf("SWEET GMU:   GMU perf %u: %6u kHz vlvl %3u vote 0x%08x%s\n", i, gmu_level_khz[i], gmu_level_vlvl[i],
+		    gm_cx_votes[i], gm_cx_votes[i] == gmu_level_vote_want[i] ? "" : " DIFFERS FROM THE PLAN");
+		ok = ok && gm_cx_votes[i] == gmu_level_vote_want[i];
+	}
+	gm_votes_ok = ok;
+	return ok;
+}
+
+/* a6xx_gmu_oob_set for the a615 family: request bit req + 16, ack bit req + 24. */
+static bool
+gmu_oob_set(unsigned req, const char *name)
+{
+	const uint32_t ack = 1u << (req + 24u);
+	gmu_wr(gm_gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET, 1u << (req + 16u));
+	bool ok = gmu_wait(REG_A6XX_GMU_GMU2HOST_INTR_INFO, ack, ack, GMU_TIMEOUT_US);
+	printf("SWEET GMU:   OOB %s (bit %u): %s, GMU2HOST_INTR_INFO 0x%08x\n", name, req + 16u,
+	    ok ? "acked" : "NO ACK in 100 ms", gmu_rd(gm_gmu, REG_A6XX_GMU_GMU2HOST_INTR_INFO));
+	if (ok) {
+		gmu_wr(gm_gmu, REG_A6XX_GMU_GMU2HOST_INTR_CLR, ack);
+	}
+	return ok;
+}
