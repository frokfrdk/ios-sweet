+static void
+gmu_log_pdc(vm_offset_t cfg, vm_offset_t seq, const char *when)
+{
+	printf("SWEET GMU: PDC %s: ENABLE_PDC 0x%08x SEQ_START_ADDR 0x%08x seq %08x %08x %08x %08x %08x\n", when,
+	    gpu_rd(cfg, PDC_ENABLE_PDC * 4u), gpu_rd(cfg, PDC_SEQ_START_ADDR * 4u), gpu_rd(seq, 0), gpu_rd(seq, 4),
+	    gpu_rd(seq, 8), gpu_rd(seq, 12), gpu_rd(seq, 16));
+	for (unsigned t = 0; t < 4; ++t) {
+		uint32_t b = PDC_TCS_CONTROL(t);
+		printf("SWEET GMU:   PDC TCS%u control 0x%08x enable 0x%08x wait 0x%08x", t, gpu_rd(cfg, b * 4u),
+		    gpu_rd(cfg, (b + PDC_TCS_ENABLE) * 4u), gpu_rd(cfg, (b + PDC_TCS_WAIT) * 4u));
+		for (unsigned c = 0; c < 3; ++c) {
+			uint32_t r = b + PDC_TCS_CMD(c);
+			printf(" | %#x %#x %#x", gpu_rd(cfg, r * 4u), gpu_rd(cfg, (r + 1u) * 4u), gpu_rd(cfg, (r + 2u) * 4u));
+		}
+		printf("\n");
+	}
+}
