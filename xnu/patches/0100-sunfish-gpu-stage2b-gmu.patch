+bool
+sweet_gmu_hfi(void)
+{
+	printf("SWEET GMU: 2B.5 HFI v1: start, INIT, FW_VER, PERF_TBL, BW_TBL, TEST\n");
+	if (!gm_votes_ok) {
+		printf("SWEET GMU: 2B.5 needs 2B.4\n");
+		return false;
+	}
+	static const char *const bcm[4] = { "MC0", "SH0", "ACV", "CN0" };
+	uint32_t bcm_addr[4];
+	for (unsigned i = 0; i < 4; ++i) {
+		if (gmu_cmddb(bcm[i], CMDDB_BCM, &bcm_addr[i], NULL, 0, NULL)) {
+			return false;
+		}
+	}
+	gpu_pause("HFI start (HFI_CTRL_INIT = 1)");
+	gmu_wr(gm_gmu, REG_A6XX_GMU_HFI_CTRL_INIT, 1);
+	bool ok = gmu_wait(REG_A6XX_GMU_HFI_CTRL_STATUS, 1, 1, GMU_TIMEOUT_US);
+	uint32_t ver = gmu_rd(gm_gmu, REG_A6XX_GMU_HFI_VERSION_INFO);
+	printf("SWEET GMU:   HFI_CTRL_STATUS 0x%08x (%s), HFI_VERSION_INFO 0x%08x (major %u)\n",
+	    gmu_rd(gm_gmu, REG_A6XX_GMU_HFI_CTRL_STATUS), ok ? "up" : "NOT UP in 100 ms", ver, ver >> 28);
+	if (!ok || ver >> 28 >= 2) {
+		printf("SWEET GMU: 2B.5 stopped: %s\n", ok ? "the firmware speaks HFI v2; this code speaks v1" :
+		    "HFI did not start");
+		return false;
+	}
+
+	gpu_pause("HFI INIT (dump buffer 0x60200000, cold boot)");
+	gmu_msg_clear();
+	gm_msg[1] = 0;
+	gm_msg[2] = GMU_VA_DUMP;
+	gm_msg[3] = GMU_DUMP_SIZE;
+	gm_msg[4] = 1;
+	if (!gmu_hfi_send(H2F_MSG_INIT, 5, "INIT", NULL)) {
+		return false;
+	}
+
+	gpu_pause("HFI FW_VER (we support 1.8)");
+	uint32_t fwver = 0;
+	gmu_msg_clear();
+	gm_msg[1] = HFI_FW_VER_SUPPORTED;
+	if (!gmu_hfi_send(H2F_MSG_FW_VER, 2, "FW_VER", &fwver)) {
+		return false;
+	}
+	unsigned major = (fwver >> 28) & 0xfu, minor = (fwver >> 16) & 0xfffu;
+	printf("SWEET GMU:   firmware version 0x%08x = %u.%u (step %u)\n", fwver, major, minor, fwver & 0xffffu);
+	if (major != 1 || minor < 8) {
+		printf("SWEET GMU: 2B.5 stopped: expected firmware 1.8 or a later 1.x\n");
+		return false;
+	}
+
+	gpu_pause("HFI PERF_TBL v1 (8 GPU levels, 2 GMU levels)");
+	gmu_msg_clear();
+	gm_msg[1] = GPU_LEVELS;
+	gm_msg[2] = GMU_LEVELS;
+	for (unsigned i = 0; i < GPU_LEVELS; ++i) {
+		gm_msg[3u + 2u * i] = gm_gx_votes[i];
+		gm_msg[4u + 2u * i] = gpu_level_khz[i];
+	}
+	for (unsigned i = 0; i < GMU_LEVELS; ++i) {
+		gm_msg[3u + 2u * HFI_MAX_GX_LEVELS + 2u * i] = gm_cx_votes[i];
+		gm_msg[4u + 2u * HFI_MAX_GX_LEVELS + 2u * i] = gmu_level_khz[i];
+	}
+	if (!gmu_hfi_send(H2F_MSG_PERF_TBL, 3u + 2u * (HFI_MAX_GX_LEVELS + HFI_MAX_CX_LEVELS), "PERF_TBL", NULL)) {
+		return false;
+	}
+
+	/*
+	 * Mainline's a618 table: one "off" level, since the 618 GMU does no bus
+	 * scaling. Layout: hdr, bw_level_num, cnoc_cmds_num, ddr_cmds_num,
+	 * cnoc_wait, ddr_wait, cnoc_addrs[6], cnoc_data[2][6], ddr_addrs[8],
+	 * ddr_data[16][8].
+	 */
+	gpu_pause("HFI BW_TBL (one off level; MC0, SH0, ACV, CN0 from cmd-db)");
+	gmu_msg_clear();
+	gm_msg[1] = 1;
+	gm_msg[2] = 1;
+	gm_msg[3] = 3;
+	gm_msg[4] = 1;
+	gm_msg[5] = 1;
+	gm_msg[6] = bcm_addr[3];
+	gm_msg[12] = 0x40000000u;
+	gm_msg[18] = 0x60000001u;
+	for (unsigned i = 0; i < 3; ++i) {
+		gm_msg[24u + i] = bcm_addr[i];
+		gm_msg[32u + i] = 0x40000000u;
+	}
+	if (!gmu_hfi_send(H2F_MSG_BW_VOTE_TBL, HFI_MSG_MAX, "BW_TBL", NULL)) {
+		return false;
+	}
+
+	gpu_pause("HFI TEST (the last message with hfi-use-reg)");
+	gmu_msg_clear();
+	if (!gmu_hfi_send(H2F_MSG_TEST, 2, "TEST", NULL)) {
+		return false;
+	}
+	sweet_gmu_status("after HFI");
+	printf("SWEET GMU: 2B.5 done: HFI up, all five messages acked\n");
+	return true;
+}
+
+bool
+sweet_gmu_oob_gpu(void)
+{
+	printf("SWEET GMU: 2B.6 OOB_GPU, then DCVS through the registers\n");
+	gpu_pause("OOB_GPU (HOST2GMU bit 16): GX stays on for the host");
+	if (!gmu_oob_set(OOB_GPU, "gpu")) {
+		sweet_gmu_status("after OOB_GPU");
+		return false;
+	}
+	gpu_pause("DCVS perf index 1 (180 MHz) through the mailbox, OOB_DCVS (bit 23)");
+	bool ok = gmu_set("DCVS_ACK_OPTION", REG_A6XX_GMU_DCVS_ACK_OPTION, 0);
+	ok = gmu_set("DCVS_PERF_SETTING", REG_A6XX_GMU_DCVS_PERF_SETTING, DCVS_PERF_AT_LEAST_1) && ok;
+	ok = gmu_set("DCVS_BW_SETTING", REG_A6XX_GMU_DCVS_BW_SETTING, DCVS_BW_NO_CHANGE) && ok;
+	ok = ok && gmu_oob_set(OOB_DCVS, "dcvs");
+	printf("SWEET GMU:   DCVS_RETURN 0x%08x\n", gmu_rd(gm_gmu, REG_A6XX_GMU_DCVS_RETURN));
+	gmu_wr(gm_gmu, REG_A6XX_GMU_HOST2GMU_INTR_SET, 1u << (OOB_DCVS + 24u));   /* oob_clear */
+	sweet_gmu_status("after OOB_GPU and DCVS");
+	return ok;
+}
