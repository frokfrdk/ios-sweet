+/* sweet_rpmh_cmddb_query, waiting out a vote that holds the RPMh lock. */
+static int
+gmu_cmddb(const char *res, unsigned slave, uint32_t *addr, unsigned *vlvl, unsigned nmax, unsigned *n)
+{
+	for (unsigned tries = 0; tries < 10; ++tries) {
+		int error = sweet_rpmh_cmddb_query(res, slave, addr, vlvl, nmax, n);
+		if (error != EBUSY) {
+			if (error) {
+				printf("SWEET GMU:   cmd-db %s: errno %d\n", res, error);
+			}
+			return error;
+		}
+		gpu_sleep_ms(500);
+	}
+	printf("SWEET GMU:   cmd-db %s: RPMh busy\n", res);
+	return EBUSY;
+}
