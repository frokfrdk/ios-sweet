+/*
+ * Pixel 4a (sunfish, boot-arg sweetfts=1): STMicro FTM5 at 0x49 on the same
+ * SE7 / qup11 pins (TLMM 6/7) and reset/IRQ pins (TLMM 8/9) as the GT9896.
+ * Protocol from Google's kernel/msm-modules/fts_touch (I2C build): the FIFO
+ * read command 0x86 returns 8-byte events, byte 7 = events still queued;
+ * a reset pulse is answered by EVT_ID_CONTROLLER_READY; scanning starts with
+ * scan mode ACTIVE {0xA0, 0x00, 0xFF}. TLMM 72 selects the bus owner (low = AP).
+ * Power is PM6150 GPIO4 on this board; nothing here drives it.
+ */
+#define FTS5_ADDR       0x49u
+#define FTS5_FIFO_READ  0x86u
+#define FTS5_EVENT_LEN  8u
+#define FTS5_BATCH      11u     /* 88 bytes: touch_msg reads at most 90 */
+#define FTS5_EVT_READY  0x03u
+#define FTS5_EVT_ENTER  0x13u
+#define FTS5_EVT_MOTION 0x23u
+#define FTS5_EVT_LEAVE  0x33u
+#define FTS5_MAX_X      1079
+#define FTS5_MAX_Y      2339    /* st,max-coords <1079 2339> */
+
 #define SE_STATUS       0x040u
 #define SE_MCLK         0x048u
 #define SE_FW           0x068u
