+/*
+ * 0120 (sweetfb_swapwait): SwapEnd only records a frame and the vsync loop
+ * copies it later, but nothing told CA when that copy was done (SwapWait
+ * returned at once, no swap-complete notifications), so CA could draw the
+ * next frame into a surface the copy was still reading or had not read yet:
+ * GMEM bins (with tiling) or triangles (sysmem) of the next frame showed up.
+ * A swap now waits (1 ms polls, 50 ms cap) until the previous frame has been
+ * copied, which is when a real display releases the old buffer.
+ */
+#define SWEET_FB_SWAP_WAIT_MS   50u
+static int sweet_fb_swapwait = 1;
+static uint64_t sweet_fb_swapwait_n, sweet_fb_swapwait_ms, sweet_fb_swapwait_max, sweet_fb_swapwait_late;
+
 /* 8a.2 (sweetfb_gpucopy=1): see the comment at the top; one AppleCLCD, its vsync work loop only */
 #define SWEET_FB_GPU_PAGE       4096u           /* GPU pages; XNU's are 16 KiB */
 #define SWEET_FB_GPU_IMPORTS    3u
