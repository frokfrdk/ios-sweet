@@ -799,6 +821,24 @@
 AppleCLCD::swap(const uint8_t *rec)
 {
 	IOLockLock(fLock);
+	/* 0120: wait until the previous frame has been copied (see sweetfb_swapwait above) */
+	uint32_t waited = 0;
+	while (sweet_fb_swapwait && !fPowerOff && (fDirty || fPresenting) && waited < SWEET_FB_SWAP_WAIT_MS) {
+		IOLockUnlock(fLock);
+		IOSleep(1);
+		waited++;
+		IOLockLock(fLock);
+	}
+	if (waited != 0) {
+		sweet_fb_swapwait_n++;
+		sweet_fb_swapwait_ms += waited;
+		if (waited > sweet_fb_swapwait_max) {
+			sweet_fb_swapwait_max = waited;
+		}
+		if (waited >= SWEET_FB_SWAP_WAIT_MS && (fDirty || fPresenting)) {
+			sweet_fb_swapwait_late++;
+		}
+	}
 	memcpy(fPending, rec, SWEET_FB_SWAP_REC_SIZE);
 	fDirty = true;
