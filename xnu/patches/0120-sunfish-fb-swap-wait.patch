 	}
+	if (sweet_fb_swapwait_n != 0 || sweet_fb_swapwait_late != 0) {
+		IOLog("SWEET FBSWAP: %llu swaps waited/5s, %llu ms in all, max %llu ms, %llu gave up after %u ms\n",
+		    sweet_fb_swapwait_n, sweet_fb_swapwait_ms, sweet_fb_swapwait_max, sweet_fb_swapwait_late,
+		    SWEET_FB_SWAP_WAIT_MS);
+		sweet_fb_swapwait_n = sweet_fb_swapwait_ms = sweet_fb_swapwait_max = sweet_fb_swapwait_late = 0;
+	}
 }
 
