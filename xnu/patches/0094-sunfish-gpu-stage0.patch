+#define RH_ARC          3u
 #define RH_VRM          4u
+#define RH_BCM          5u
+#define RH_ARC_LEVELS   16u      /* Linux rpmhpd RPMH_ARC_MAX_LEVELS */
 #define RH_TIMEOUT_US   100000u
 
