+/* Logs the n dwords of the message in gm_rsp, four per line. */
+static void
+gmu_hfi_dump(const char *name, const char *what, unsigned n)
+{
+	const unsigned m = n < HFI_MSG_MAX ? n : HFI_MSG_MAX;
+	for (unsigned i = 0; i < m; i += 4) {
+		printf("SWEET GMU:   HFI %s: %s [%u]", name, what, i);
+		for (unsigned j = i; j < m && j < i + 4; ++j) {
+			printf(" 0x%08x", gm_rsp[j]);
+		}
+		printf("\n");
+	}
+}
