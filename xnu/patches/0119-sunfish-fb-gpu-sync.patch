+	int r = sweet_gsvc_wait_idle(SWEET_FB_SYNC_WAIT_MS);
+	if (r == ENXIO) {
+		return true;    /* no GPU service (yet): CPU-drawn surfaces only */
+	}
+	if (r != 0) {
+		/* a GPU that never goes idle must not freeze the screen: the third try in a row copies anyway */
