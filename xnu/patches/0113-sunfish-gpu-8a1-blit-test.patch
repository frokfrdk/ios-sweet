+/*
+ * 8a.1: the 2D blitter as fd6_blitter's buffer path and turnip's r2d use it
+ * (CP_BLIT BLIT_OP_SCALE, no shader). Offsets, fields and a618 values are
+ * from Mesa 26.2.5 (a6xx.xml, adreno_pm4.xml, freedreno_devices.py; MIT).
+ */
+#define GS_GRAS_A2D_BLT_CNTL            0x08400u
+#define GS_GRAS_A2D_SRC_XMIN            0x08401u        /* XMAX, YMIN, YMAX, DEST_TL, DEST_BR follow */
+#define GS_RB_A2D_BLT_CNTL              0x08c00u        /* RB_A2D_PIXEL_CNTL follows */
+#define GS_RB_A2D_DEST_BUFFER_INFO      0x08c17u        /* BASE (64-bit) and PITCH follow */
+#define GS_RB_RBP_CNTL                  0x08e01u
+#define GS_RB_DBG_ECO_CNTL              0x08e04u
+#define GS_RB_CCU_CNTL                  0x08e07u
+#define GS_SP_A2D_OUTPUT_INFO           0x0acc0u
+#define GS_TPL1_A2D_SRC_TEXTURE_INFO    0x0b4c0u        /* SIZE, BASE (64-bit) and PITCH follow */
+#define PM4_CP_WAIT_FOR_IDLE    0x26u
+#define PM4_CP_BLIT             0x2cu
+#define PM4_CP_SET_MARKER       0x65u
+#define EV_CCU_FLUSH_DEPTH_TS   0x1cu
+#define EV_CCU_FLUSH_COLOR_TS   0x1du
+#define RM6_BLIT2DSCALE         12u
+#define BLIT_OP_SCALE           3u
+#define FMT6_8_8_8_8_UNORM      0x30u
+#define BL_BLT_CNTL             ((0xfu << 20) | (FMT6_8_8_8_8_UNORM << 8))      /* MASK, R2D_UNORM8, ROTATE_0 */
+#define BL_OUTPUT_INFO          ((0xfu << 12) | (FMT6_8_8_8_8_UNORM << 3))      /* MASK, OUTPUT_IFMT_2D_FLOAT */
+#define BL_SRC_INFO             ((1u << 22) | (1u << 20) | FMT6_8_8_8_8_UNORM)  /* UNK22, UNK20, linear, WZYX */
+#define BL_DST_INFO             FMT6_8_8_8_8_UNORM                              /* linear, WZYX */
+/* sysmem CCU layout: depth at 0, colour after one CCU's 64 KiB depth cache, both CCU_CACHE_SIZE_FULL */
+#define BL_CCU_CNTL             ((0x10000u >> 12) << 23)
+#define BL_PITCH                3328u           /* the CA surfaces' bytes per row; 2D pitches are in 64 bytes */
+#define BL_POISON               0x5ee7b1a7u
+#define BL_TS_OFF               0x800u          /* in the IB BO: where the CCU flush events write */
+
+/* a618 magic_regs and raw_magic_regs, written by sweetblit=2 */
+static const uint32_t gs_blit_magic[][2] = {
+	{ 0x09804u, 0x0000001fu },      /* PC_MODE_CNTL */
+	{ 0x09805u, 0 },                /* PC_POWER_CNTL */
+	{ 0x0a0f8u, 0 },                /* VFD_POWER_CNTL */
+	{ 0x0b600u, 0x00108000u },      /* TPL1_DBG_ECO_CNTL */
+	{ 0x08600u, 0x00000880u },      /* GRAS_DBG_ECO_CNTL */
+	{ 0x0ae03u, 0x00000430u },      /* SP_CHICKEN_BITS */
+	{ 0x0ae00u, 0 },                /* SP_DBG_ECO_CNTL */
+	{ 0x0be04u, 0x00080000u },      /* HLSQ_DBG_ECO_CNTL */
+	{ 0x09600u, 0 },                /* VPC_DBG_ECO_CNTL */
+	{ 0x00e12u, 0x00000001u },      /* UCHE_UNKNOWN_0E12 */
+	{ GS_RB_DBG_ECO_CNTL, 0x04100000u },    /* the same value for blits on a618 */
+	{ GS_RB_RBP_CNTL, 0x00000001u },
+};
