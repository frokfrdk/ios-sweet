+
+/* Map the MDP and check that VIG0 scans the panel buffer; the canvas buffer follows it in the carve-out. */
+bool
+AppleCLCD::mdpSetup(void)
+{
+	uint64_t panelBytes = (uint64_t)fRowBytes * fHeight;
+	uint64_t canvasBytes = (uint64_t)fLogicalW * 4 * fLogicalH;
+	if (fPhys != SWEET_MDP_SPLASH_PA || panelBytes > SWEET_MDP_CANVAS_OFF ||
+	    SWEET_MDP_CANVAS_OFF + canvasBytes > SWEET_MDP_SPLASH_SIZE) {
+		IOLog("SWEET FB: MDP scaling not used (framebuffer 0x%llx, %llu + %llu bytes)\n",
+		    fPhys, panelBytes, canvasBytes);
+		return false;
+	}
+	fMdpRegs = ml_io_map((vm_offset_t)SWEET_MDP_PA, SWEET_MDP_SIZE);
+	if (fMdpRegs == 0) {
+		return false;
+	}
+	uint32_t ver = sweet_mdp_rd(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_VERSION);
+	uint32_t op = sweet_mdp_rd(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_OP_MODE);
+	uint32_t srcSize = sweet_mdp_rd(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC_SIZE);
+	uint32_t outSize = sweet_mdp_rd(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_OUT_SIZE);
+	uint32_t addr = sweet_mdp_rd(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC0_ADDR);
+	uint32_t stride = sweet_mdp_rd(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC_YSTRIDE0);
+	for (uint32_t i = 0; i < SWEET_MDP_CTLS; i++) {
+		for (uint32_t lm = 0; lm < 4; lm++) {     /* CTL_LAYER(LM0..LM3); VIG0's blend stage is bits 0-2 */
+			if (sweet_mdp_rd(fMdpRegs, SWEET_MDP_CTL(i) + 4 * lm) & 0x7) {
+				fMdpCtls |= 1u << i;
+			}
+		}
+	}
+	IOLog("SWEET FB: MDP qseed ver 0x%x op 0x%x, VIG0 src 0x%x out 0x%x addr 0x%x stride 0x%x, CTLs 0x%x\n",
+	    ver, op, srcSize, outSize, addr, stride, fMdpCtls);
+	if (ver == 0 || ver == 0xffffffffu || addr != (uint32_t)fPhys ||
+	    outSize != ((fHeight << 16) | fWidth) || fMdpCtls == 0) {
+		IOLog("SWEET FB: MDP scaling not used (unexpected VIG0 state)\n");
+		return false;
+	}
+	fCanvasPhys = fPhys + SWEET_MDP_CANVAS_OFF;
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withPhysicalAddress(fCanvasPhys,
+	    round_page(canvasBytes), kIODirectionInOut);
+	if (md != NULL) {
+		fCanvasMap = md->createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
+		md->release();
+	}
+	if (fCanvasMap == NULL) {
+		IOLog("SWEET FB: MDP scaling not used (no canvas mapping)\n");
+		return false;
+	}
+	fCanvas = (uintptr_t)fCanvasMap->getVirtualAddress();
+	return true;
+}
+
+/* VIG0: fetch the canvas buffer, QSEED3-Lite bilinear upscale to the panel; latch with a CTL flush. */
+void
+AppleCLCD::mdpSwitch(void)
+{
+	uint32_t size = (fLogicalH << 16) | fLogicalW;
+	uint32_t stepX = (uint32_t)(((uint64_t)fLogicalW << 21) / fWidth);
+	uint32_t stepY = (uint32_t)(((uint64_t)fLogicalH << 21) / fHeight);
+	uint32_t op = SWEET_MDP_QSEED_OP_RGB_BIL;
+	if (sweet_mdp_rd(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC_FORMAT) & SWEET_MDP_SRC_FORMAT_ALPHA) {
+		op |= SWEET_MDP_QSEED_OP_ALPHA_BIL;
+	}
+	for (uint32_t i = 0; i < 4; i++) {
+		sweet_mdp_wr(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_PHASE_INIT(i), 0);
+		sweet_mdp_wr(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_PHASE_STEP(i), (i & 1) ? stepY : stepX);
+	}
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_PRELOAD, SWEET_MDP_QSEED_PRELOAD_DEF);
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_SRC_SIZE_Y, size);
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_SRC_SIZE_UV, size);
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_DST_SIZE, (fHeight << 16) | fWidth);
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_QSEED + SWEET_MDP_QSEED_OP_MODE, op);
+	for (uint32_t c = 0; c < 3; c++) {        /* pixel extension: none, request the whole source */
+		sweet_mdp_wr(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_PIX_EXT(c) + 0, 0);
+		sweet_mdp_wr(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_PIX_EXT(c) + 4, 0);
+		sweet_mdp_wr(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_PIX_EXT(c) + 8, size);
+	}
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC_SIZE, size);
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC_XY, 0);
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC_YSTRIDE0, fLogicalW * 4);
+	sweet_mdp_wr(fMdpRegs, SWEET_MDP_VIG0 + SWEET_MDP_SSPP_SRC0_ADDR, (uint32_t)fCanvasPhys);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (uint32_t i = 0; i < SWEET_MDP_CTLS; i++) {
+		if (fMdpCtls & (1u << i)) {
+			sweet_mdp_wr(fMdpRegs, SWEET_MDP_CTL(i) + SWEET_MDP_CTL_FLUSH, SWEET_MDP_CTL_FLUSH_VIG0);
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	fVis = fCanvas;
+	fVisW = fLogicalW;
+	fVisH = fLogicalH;
+	fVisRowBytes = fLogicalW * 4;
+	fMdpOn = true;
+	IOLog("SWEET FB: MDP scaling on: VIG0 %ux%u -> %ux%u, op 0x%x, step 0x%x/0x%x\n",
+	    fLogicalW, fLogicalH, fWidth, fHeight, op, stepX, stepY);
 }
 
