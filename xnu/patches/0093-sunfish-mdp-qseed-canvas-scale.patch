 #define SWEET_FB_LOGICAL_W              1125
 #define SWEET_FB_LOGICAL_H              2436
 #define SWEET_FB_FORMAT_BGRA            0x42475241
+/*
+ * Boot-arg sweetfb_mdpscale=1 (scaled canvas only): the MDP upscales the
+ * canvas instead of the CPU. ABL scans the panel buffer (cont_splash,
+ * 0x9c000000, 23 MB carve-out, unused by XNU) through SSPP VIG0, which has
+ * a QSEED3-Lite scaler (sdmmagpie: qcom,sde-qseed-type "qseedv3lite",
+ * qcom,sde-vig-qseed-off 0xa00). From the first frame on, the canvas is
+ * copied unscaled into a second buffer in the carve-out and VIG0 fetches it
+ * with bilinear scaling to the panel size (as Linux sde_plane.c
+ * _sde_plane_setup_scaler3 + sde_hw_setup_scaler3 do for RGB), then a CTL
+ * flush latches it at the next frame. The CPU copies 5.9 MB per frame and
+ * scales nothing; the kernel console keeps drawing into the panel buffer,
+ * which is no longer shown.
+ */
+#define SWEET_MDP_PA                    0x0ae00000ULL
+#define SWEET_MDP_SIZE                  0x8000
+#define SWEET_MDP_SPLASH_PA             0x9c000000ULL
+#define SWEET_MDP_SPLASH_SIZE           0x1700000
+#define SWEET_MDP_CANVAS_OFF            0xa00000        /* after the 1080x2340 panel buffer */
+#define SWEET_MDP_CTL(i)                (0x2000 + 0x200 * (i))
+#define SWEET_MDP_CTLS                  6
+#define SWEET_MDP_CTL_FLUSH             0x18
+#define SWEET_MDP_CTL_FLUSH_VIG0        (1u << 0)
+#define SWEET_MDP_VIG0                  0x5000
+#define SWEET_MDP_SSPP_SRC_SIZE         0x00
+#define SWEET_MDP_SSPP_SRC_XY           0x08
+#define SWEET_MDP_SSPP_OUT_SIZE         0x0c
+#define SWEET_MDP_SSPP_SRC0_ADDR        0x14
+#define SWEET_MDP_SSPP_SRC_YSTRIDE0     0x24
+#define SWEET_MDP_SSPP_SRC_FORMAT       0x30
+#define SWEET_MDP_SSPP_PIX_EXT(c)       (0x100 + 0x10 * (c))    /* +0 LR, +4 TB, +8 REQ_PIXELS */
+#define SWEET_MDP_QSEED                 (SWEET_MDP_VIG0 + 0xa00)
+#define SWEET_MDP_QSEED_VERSION         0x00
+#define SWEET_MDP_QSEED_OP_MODE         0x04
+#define SWEET_MDP_QSEED_PHASE_STEP(i)   (0x10 + 4 * (i))        /* Y_H, Y_V, UV_H, UV_V */
+#define SWEET_MDP_QSEED_PRELOAD         0x20
+#define SWEET_MDP_QSEED_SRC_SIZE_Y      0x40
+#define SWEET_MDP_QSEED_SRC_SIZE_UV     0x44
+#define SWEET_MDP_QSEED_DST_SIZE        0x48
+#define SWEET_MDP_QSEED_PHASE_INIT(i)   (0x90 + 4 * (i))
+#define SWEET_MDP_QSEED_PRELOAD_DEF     0x03040304      /* QSEED3 h 4, v 3 for both planes */
+#define SWEET_MDP_QSEED_OP_RGB_BIL      ((1u << 0) | (3u << 16) | (1u << 14) | (1u << 31))     /* enable, bilinear, non-DX, blend */
+#define SWEET_MDP_QSEED_OP_ALPHA_BIL    ((1u << 10) | (1u << 29))
+#define SWEET_MDP_SRC_FORMAT_ALPHA      (1u << 8)
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+static inline uint32_t
+sweet_mdp_rd(vm_offset_t base, uint32_t off)
+{
+	return *(volatile uint32_t *)(base + off);
+}
+
+static inline void
+sweet_mdp_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	*(volatile uint32_t *)(base + off) = val;
+}
 
