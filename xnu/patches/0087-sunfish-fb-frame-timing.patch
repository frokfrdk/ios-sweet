--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -149,6 +149,33 @@
 
 OSDefineMetaClassAndStructors(IOMobileFramebufferUserClient, IOUserClient);
 
+/*
+ * Frame timing (boot-arg sweetfbstat=1): every 5 s, swaps (frames CA
+ * produced) and presents (panel copies) per second, plus the copy cost and
+ * the CPU that ran it. Swaps are counted on the client threads, the rest on
+ * the vsync work loop; the counters only feed a log line.
+ */
+extern "C" int cpu_number(void);
+static int sweet_fb_stat;
+static uint64_t sweet_fb_stat_swaps, sweet_fb_stat_swaps_seen;
+static uint64_t sweet_fb_stat_presents, sweet_fb_stat_copy_abs, sweet_fb_stat_copy_max, sweet_fb_stat_bytes;
+static int sweet_fb_stat_cpu = -1;
+
+static void
+sweet_fb_stat_report(void)
+{
+	uint64_t n = sweet_fb_stat_presents, avg_ns = 0, max_ns = 0;
+	uint64_t swaps = sweet_fb_stat_swaps - sweet_fb_stat_swaps_seen;
+	sweet_fb_stat_swaps_seen += swaps;
+	if (n != 0) {
+		absolutetime_to_nanoseconds(sweet_fb_stat_copy_abs / n, &avg_ns);
+	}
+	absolutetime_to_nanoseconds(sweet_fb_stat_copy_max, &max_ns);
+	IOLog("SWEET FBSTAT: swaps %llu/s presents %llu/s copy avg %llu us max %llu us (%llu MB/5s) cpu %d\n",
+	    swaps / 5, n / 5, avg_ns / 1000, max_ns / 1000, sweet_fb_stat_bytes >> 20, sweet_fb_stat_cpu);
+	sweet_fb_stat_presents = sweet_fb_stat_copy_abs = sweet_fb_stat_copy_max = sweet_fb_stat_bytes = 0;
+}
+
 bool
