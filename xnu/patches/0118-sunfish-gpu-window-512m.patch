-		return false;
+	/* 0118: zeroed and cleaned to PoC by gs_kalloc, then written only through the uncached mapping */
+	vm_offset_t l3k = gs_kalloc(GS_L3_TABLES * GS_PAGE, &gs_l3_pa);
+	vm_offset_t l3u = l3k ? ml_io_map_wcomb((vm_offset_t)gs_l3_pa, GS_L3_TABLES * GS_PAGE) : 0;
+	if (l3u) {
+		gs_l3 = (volatile uint64_t *)l3u;
+		printf("SWEET GSVC:   %-12s pa/iova %#llx, %#x bytes, XNU memory mapped uncached\n", "window L3s", gs_l3_pa,
+		    GS_L3_TABLES * GS_PAGE);
+	} else {
+		if (l3k) {
+			kmem_free(kernel_map, l3k, GS_L3_TABLES * GS_PAGE);
+		}
+		printf("SWEET GSVC:   no contiguous XNU memory for %u L3 tables: %u in GPU-GMU-MEM\n", GS_L3_TABLES,
