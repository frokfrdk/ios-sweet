@@ -123,11 +124,15 @@
  * Mesa's own BOs did not look like fitting 64 MiB and 64 BOs. 64 L3 tables
  * (256 KiB) still fit the 0x55000 bytes of GPU-GMU-MEM left after the IB pool
  * and the L2 table (G6o: L3s at +0xab000 of the 1 MiB blob).
+ * 0118: G7c filled those 128 MiB (7 MiB textures refused with 14 MiB free in
+ * pieces). 256 tables (1 MiB, 512 MiB of window) now come from contiguous XNU
+ * memory mapped uncached like GPU-GMU-MEM; the 64 there stay the fallback.
  */
-#define GS_L3_TABLES            64u
+#define GS_L3_TABLES            256u
+#define GS_L3_GMU               64u
 #define GS_WIN_BASE             0x200000000ull  /* GPU VA 8 GiB, level-1 entry 8 */
 #define GS_WIN_L1               8u
-#define GS_WIN_PAGES            (GS_L3_TABLES * 512u)   /* 128 MiB */
+#define GS_WIN_PAGES            (GS_L3_TABLES * 512u)   /* 512 MiB at most; gs_win_pages is what is mapped */
 #define GS_PTE_TABLE            3ull
 #define GS_PTE_PAGE_RW          0xe43ull        /* page, AP read/write, outer shareable, AF, nG, MAIR attr 0 */
 #define GS_PTE_ADDR_MASK        0x0000fffffffff000ull
@@ -245,6 +250,7 @@
