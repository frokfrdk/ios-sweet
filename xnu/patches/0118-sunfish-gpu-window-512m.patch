+	for (uint32_t p = 0; p < gs_win_pages; ++p) {
+		if (p % 32u == 0 && gs_win_used[p / 32u] == 0xffffffffu) {
+			run = 0;
+			p += 31u;
+			continue;
+		}
 		run = gs_win_busy(p) ? 0 : run + 1u;
 		if (run == n) {
 			gs_win_mark(p + 1u - n, n, true);
@@ -615,8 +626,8 @@
 gs_win_count(void)
 {
 	uint32_t n = 0;
-	for (uint32_t p = 0; p < GS_WIN_PAGES; ++p) {
-		n += gs_win_busy(p);
+	for (uint32_t w = 0; w < gs_win_pages / 32u; ++w) {
+		n += (uint32_t)__builtin_popcount(gs_win_used[w]);
 	}
 	return n;
 }
@@ -712,10 +723,25 @@
 		return false;
 	}
 	gs_l2 = (volatile uint64_t *)v;
