+++ b/bsd/kern/kern_exec.c
@@ -451,6 +451,69 @@ exec_add_user_string(struct image_params *imgp, user_addr_t str, int seg, boolea
  */
 #define EXECUTABLE_KEY "executable_path="
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * SWEET: boot-arg sweetenv=name:VAR=VAL[;name:VAR=VAL...] adds VAR=VAL to
+ * the environment of every exec whose file name (the last path component)
+ * is name. It goes after the caller's own variables, so one the caller set
+ * wins (getenv and dyld take the first). For the GL shim (GPU plan 7.6):
+ *   sweetenv=backboardd:DYLD_INSERT_LIBRARIES=/usr/lib/sweetgl.dylib
+ * dyld honours DYLD_* only because sweet_amfi.c answers its policy query.
+ * Boot-args end at a space, so a value cannot hold one. An entry that does
+ * not fit the argument space is skipped (logged), never fails the exec.
+ */
+#define SWEET_ENV_MAX   256
+static char sweet_env[SWEET_ENV_MAX];
+static _Atomic int sweet_env_state;     /* 0 unread, 1 reading, 2 none, 3 set */
+
+static void
+sweet_exec_add_env(struct image_params *imgp, int ptr_size)
+{
+	int state = os_atomic_load(&sweet_env_state, acquire);
+	if (state == 0 && os_atomic_cmpxchg(&sweet_env_state, 0, 1, relaxed)) {
+		bool set = PE_parse_boot_argn("sweetenv", sweet_env, sizeof(sweet_env)) && sweet_env[0] != '\0';
+		state = set ? 3 : 2;
+		os_atomic_store(&sweet_env_state, state, release);
+		if (set) {
+			printf("SWEET env: sweetenv=%s\n", sweet_env);
+		}
+	}
+	if (state != 3) {
+		return;         /* none, or the first exec is still reading it */
+	}
+	const char *name = imgp->ip_strings + strlen(EXECUTABLE_KEY);
+	for (const char *c = name; *c != '\0'; c++) {
+		if (*c == '/') {
+			name = c + 1;
+		}
+	}
+	size_t nlen = strlen(name);
+	for (const char *e = sweet_env; *e != '\0';) {
+		const char *end = e;
+		while (*end != '\0' && *end != ';') {
+			end++;
+		}
+		size_t len = (size_t)(end - e);
+		if (nlen > 0 && len > nlen + 1 && strncmp(e, name, nlen) == 0 && e[nlen] == ':') {
+			char kv[SWEET_ENV_MAX];
+			len -= nlen + 1;
+			memcpy(kv, e + nlen + 1, len);
+			kv[len] = '\0';
+			/* the string, its envv[] slot, and the slot of the NULL after it */
+			if (imgp->ip_argspace < (int)(len + 1) + 2 * ptr_size ||
+			    exec_add_user_string(imgp, CAST_USER_ADDR_T(kv), UIO_SYSSPACE, TRUE) != 0) {
+				printf("SWEET env: %s: no room for %s, skipped\n", name, kv);
+			} else {
+				imgp->ip_argspace -= ptr_size;
+				imgp->ip_envc++;
+				printf("SWEET env: %s += %s\n", name, kv);
+			}
+		}
+		e = *end != '\0' ? end + 1 : end;
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
