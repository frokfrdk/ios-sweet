+			sweet_amfi_dyld_logged = true;
+			printf("SWEET AMFI: dyld policy in 0x%llx out 0x%llx -> 0x%llx (%d)\n",
+			    args[0], args[1], policy, error);
+		}
+		return error;
+	}
 	return ENOPOLICY;
 }
 
--- /dev/null
+++ b/iokit/Kernel/arm/SweetAccel.cpp
@@ -0,0 +1,47 @@
+/*
+ * IOAcceleratorES stand-in for the GL shim (docs/GPU_A618_PLAN.md 7.6,
+ * docs/EAGL_NOTES.md). QuartzCore's CAMetalContextCreate looks for an
+ * IOAcceleratorES service up to 300 times, 100 ms apart, before it gives up
+ * on Metal, so with none backboardd loses 30 s before it tries GLES. This
+ * service has the class name and nothing else: no MetalPluginName, so Metal
+ * still finds no device, and no IOGLESBundleName, so OpenGLES's own plugin
+ * lookup still finds nothing (sweetgl replaces that path). It matches with
+ * SweetGPU, once the GPU service is ready, so CA waits for the GPU for up to
+ * those 30 s. Off unless the boot-arg sweetaccel=1.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
+
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+
+IOService *
+IOAcceleratorES::probe(IOService *provider, SInt32 *score)
+{
+	uint32_t on = 0;
+	(void)PE_parse_boot_argn("sweetaccel", &on, sizeof(on));
+	return on ? IOService::probe(provider, score) : NULL;
+}
+
+bool
+IOAcceleratorES::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("SWEET ACCEL: IOAcceleratorES stand-in registered (no Metal or GLES plugin)\n");
+	return true;
+}
+#endif /* SWEET */
