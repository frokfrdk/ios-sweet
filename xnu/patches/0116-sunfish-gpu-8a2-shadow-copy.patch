+		const uint32_t *g = (const uint32_t *)(shadow + (uint64_t)y * pitch);
+		const uint32_t *c = (const uint32_t *)(fCanvas + (uint64_t)y * fLogicalW * 4);
+		sweet_fb_gpu_rows++;
+		if (memcmp(g, c, (size_t)fLogicalW * 4) == 0) {
+			continue;
+		}
+		sweet_fb_gpu_bad_rows++;
+		if (sweet_fb_gpu_bad_logged < 8) {
+			uint32_t x = 0;
+			while (x < fLogicalW && g[x] == c[x]) {
+				x++;
+			}
+			uint32_t n = 0;
+			for (uint32_t k = x; k < fLogicalW; k++) {
+				n += g[k] != c[k];
+			}
+			sweet_fb_gpu_bad_logged++;
+			IOLog("SWEET GPUCOPY: surface %u row %u: %u pixels differ from x %u: gpu 0x%08x canvas 0x%08x\n",
