+		IOLog("SWEET GPUCOPY: first copy: surface %u %ux%u pitch %u at gpu 0x%llx -> shadow gpu 0x%llx, seq %u\n",
+		    s->id, fLogicalW, fLogicalH, pitch, imp->gva + s->offset, sweet_fb_gpu_shadow.gva, seq);
