+/*
+ * 8a.2: the GPU copies surface s (just copied into the canvas by the CPU) into
+ * the shadow buffer; 16 rows of the shadow are compared with the canvas.
+ * Returns the time spent (absolute units).
+ */
+uint64_t
+AppleCLCD::gpuShadow(SweetSurface *s)
+{
+	if (sweet_fb_gpu_off) {
+		return 0;
+	}
+	uint64_t t0 = mach_absolute_time();
+	struct sweet_gsvc_info info;
+	sweet_gsvc_info(&info);
+	if (info.flags & SWEET_GSVC_DEAD) {
+		sweet_fb_gpu_stop("the GPU service is dead", ENXIO);
+		return 0;
+	}
+	if (!(info.flags & SWEET_GSVC_READY)) {
+		sweet_fb_gpu_waiting++;
+		return 0;
+	}
+	uint32_t pitch = s->bytesPerRow;
+	uintptr_t src = s->kernelAddress();
+	uint64_t span = (uint64_t)(fLogicalH - 1) * pitch + (uint64_t)fLogicalW * 4;
+	if (src == 0 || (pitch & 63u) || (s->offset & 63u) || pitch < fLogicalW * 4 ||
+	    s->memory->getLength() > (16u << 20)) {
+		IOLog("SWEET GPUCOPY: surface %u: pitch %u offset %u length %llu not usable\n", s->id, pitch, s->offset,
+		    (uint64_t)s->memory->getLength());
+		sweet_fb_gpu_stop("surface layout", EINVAL);
+		return 0;
+	}
+	uint64_t need = (uint64_t)pitch * fLogicalH;
+	if (sweet_fb_gpu_shadow_buf != NULL && sweet_fb_gpu_shadow_buf->getLength() < need) {
+		sweet_fb_gpu_drop(&sweet_fb_gpu_shadow);
+		OSSafeReleaseNULL(sweet_fb_gpu_shadow_buf);
+	}
+	if (sweet_fb_gpu_shadow_buf == NULL) {
+		sweet_fb_gpu_shadow_buf = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut, round_page(need), SWEET_FB_GPU_PAGE);
+		if (sweet_fb_gpu_shadow_buf == NULL) {
+			sweet_fb_gpu_stop("no shadow buffer", ENOMEM);
+			return 0;
+		}
+		if (!sweet_fb_gpu_map(sweet_fb_gpu_shadow_buf, &sweet_fb_gpu_shadow)) {
+			return 0;
+		}
+	}
+	struct sweet_fb_gpu_buf *imp = sweet_fb_gpu_import(s);
+	if (imp == NULL) {
+		return 0;
+	}
+	imp->used = ++sweet_fb_gpu_uses;
+	uint8_t *shadow = (uint8_t *)sweet_fb_gpu_shadow_buf->getBytesNoCopy();
