+/*
+ * 0116: one linear BGRA8 copy, width x height at the same pitch, between window
+ * addresses (64-byte aligned, pitch a multiple of 64). The IB lives in a
+ * one-page BO made on first use; each call waits for the previous copy before
+ * it rewrites that IB, so callers are serialised. *seq is for sweet_gsvc_wait.
+ */
+static LCK_MTX_DECLARE(gs_kblit_lock, &gs_grp);
+static uint32_t gs_kblit_ib, gs_kblit_seq;
+static uint64_t gs_kblit_gva;
+static volatile uint32_t *gs_kblit_cpu;
+
+int
+sweet_gsvc_blit(uint64_t dst, uint64_t src, uint32_t pitch, uint32_t width, uint32_t height, uint32_t *seq)
+{
+	if (!gs_usable() || !gs_ready) {
+		return ENXIO;
+	}
+	if (width == 0 || height == 0 || width > 0x4000u || height > 0x4000u || (pitch & 63u) || pitch < width * 4u ||
+	    ((dst | src) & 63u)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&gs_kblit_lock);
+	int r = 0;
+	if (gs_kblit_ib == 0) {
+		r = sweet_gsvc_bo_new(GS_PAGE, 0, &gs_kblit_ib, &gs_kblit_gva, &gs_kblit_cpu);
+	}
+	if (r == 0 && gs_kblit_seq != 0) {
+		r = sweet_gsvc_wait(gs_kblit_seq, GS_WAIT_MS);
+	}
+	if (r == 0) {
+		struct gs_ibw w;
+		ibw_init(&w, gs_kblit_cpu, BL_TS_OFF / 4u);
+		ibw_blit(&w, false, true, gs_kblit_gva + BL_TS_OFF, dst, src, pitch, width, height);
+		(void)sweet_gsvc_bo_sync(gs_kblit_ib);
+		struct sweet_gsvc_ib ib = { gs_kblit_ib, 0, w.n };
+		uint32_t s = 0;
+		r = w.n > w.max ? EINVAL : sweet_gsvc_submit(&ib, 1, &s);
+		if (r == 0) {
+			gs_kblit_seq = s;
+			*seq = s;
+		}
+	}
+	lck_mtx_unlock(&gs_kblit_lock);
+	return r;
+}
