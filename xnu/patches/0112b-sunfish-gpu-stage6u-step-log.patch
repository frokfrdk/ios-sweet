 #define SWEET_GPU_CLIENT_BOS    64u
 #define SWEET_GPU_WAIT_MAX_MS   10000u
 #define SWEET_GPU_CLOSE_WAIT_MS 2000u
+#define SWEET_GPU_UC_PAUSE_MS   2000u
+
+/* sweetgpuucslow=1: log what comes next, then give the persistent log time to reach the disk */
+static int sweet_gpu_uc_slow = -1;
+
+static bool
+uc_slow(void)
+{
+	if (sweet_gpu_uc_slow < 0) {
+		int v = 0;
+		sweet_gpu_uc_slow = PE_parse_boot_argn("sweetgpuucslow", &v, sizeof(v)) && v != 0;
+	}
+	return sweet_gpu_uc_slow > 0;
+}
+
+static void uc_next(const char *fmt, ...) __printflike(1, 2);
+
+static void
+uc_next(const char *fmt, ...)
+{
+	if (!uc_slow()) {
+		return;
+	}
+	char step[128];
+	va_list ap;
+	va_start(ap, fmt);
+	vsnprintf(step, sizeof(step), fmt, ap);
+	va_end(ap);
+	IOLog("SWEET GPUUC: next: %s (in %u ms)\n", step, SWEET_GPU_UC_PAUSE_MS);
+	IOSleep(SWEET_GPU_UC_PAUSE_MS);
+}
 
