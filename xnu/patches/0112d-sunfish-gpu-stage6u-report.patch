+/* No lock: fReports is only a log budget */
+IOReturn
+SweetGPUUserClient::report(IOExternalMethodArguments *args)
+{
+	uint32_t len = args->structureInputSize;
+	if (args->structureInputDescriptor != NULL || args->structureInput == NULL || len == 0 ||
+	    len > SWEET_GPU_REPORT_MAX) {
+		return kIOReturnBadArgument;
+	}
+	if (fReports >= SWEET_GPU_REPORT_LINES) {
+		return kIOReturnSuccess;
+	}
+	char text[SWEET_GPU_REPORT_MAX + 1];
+	const unsigned char *in = (const unsigned char *)args->structureInput;
+	uint32_t n = 0;
+	for (; n < len && in[n] != '\0'; n++) {
+		text[n] = in[n] >= 0x20 && in[n] < 0x7f ? (char)in[n] : '?';
+	}
+	while (n > 0 && text[n - 1] == ' ') {
+		n--;
+	}
+	text[n] = '\0';
+	char name[32];
+	proc_selfname(name, sizeof(name));
+	fReports++;
+	IOLog("SWEET GPUUC: report from %s: %s%s\n", name, text,
+	    fReports == SWEET_GPU_REPORT_LINES ? " (the last report logged for this client)" : "");
+	return kIOReturnSuccess;
+}
