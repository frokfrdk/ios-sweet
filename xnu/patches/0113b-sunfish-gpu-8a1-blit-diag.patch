+/* 0113b: one line for a wrong row: its count, x range, and where its first bad pixel came from */
+static void
+bl_row(uint32_t width, uint32_t height, uint32_t pitch, uint32_t y, uint32_t n, uint32_t x0, uint32_t x1, uint32_t got)
+{
+	uint32_t sx, sy;
+	if (got == BL_POISON) {
+		printf("SWEET GSVC:     8a.1 %ux%u row %u: %u bad, x %u..%u; (%u,%u) not written\n", width, height, y, n,
+		    x0, x1, x0, y);
+	} else if (bl_find(got, BL_FIND_W, BL_FIND_H, &sx, &sy)) {
+		/* outside this copy's source: an earlier case's pattern, e.g. stale in a GPU cache */
+		bool outside = sx >= width || sy >= height;
+		long long delta = ((long long)sy * pitch + sx * 4) - ((long long)y * pitch + x0 * 4);
+		printf("SWEET GSVC:     8a.1 %ux%u row %u: %u bad, x %u..%u; (%u,%u) holds pattern (%u,%u)%s, "
+		    "byte offset %+lld at this pitch\n", width, height, y, n, x0, x1, x0, y, sx, sy,
+		    outside ? ", outside this source" : "", delta);
+	} else {
+		printf("SWEET GSVC:     8a.1 %ux%u row %u: %u bad, x %u..%u; (%u,%u) holds 0x%08x, no source pixel\n",
+		    width, height, y, n, x0, x1, x0, y, got);
+	}
+}
