+/*
+ * 0113b: the source pixel whose pattern is v, by inverting bl_pattern for
+ * each row (0x9e3779b1 is odd, so it has an inverse mod 2^32). False if v is
+ * no pixel of the width x height source. Searched over the largest case, so
+ * a pattern left over from an earlier case is found too.
+ */
+#define BL_FIND_W               828u
+#define BL_FIND_H               1792u
+static bool
+bl_find(uint32_t v, uint32_t width, uint32_t height, uint32_t *sx, uint32_t *sy)
+{
+	uint32_t inv = 0x9e3779b1u;
+	for (int i = 0; i < 5; ++i) {
+		inv *= 2u - 0x9e3779b1u * inv;
+	}
+	for (uint32_t y = 0; y < height; ++y) {
+		uint32_t x = (v ^ (y * 0x85ebca77u)) * inv;
+		if (x < width) {
+			*sx = x;
+			*sy = y;
+			return true;
+		}
+	}
+	return false;
+}
