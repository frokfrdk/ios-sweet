+/* a + (b - a) * f / 256 per 8-bit channel, two channels per multiply (no carry between lanes). */
+static inline uint32_t
+sweet_fb_lerp(uint32_t a, uint32_t b, uint32_t f)
+{
+	uint32_t g = 256 - f;
+	uint32_t rb = (((a & 0x00ff00ffu) * g + (b & 0x00ff00ffu) * f) >> 8) & 0x00ff00ffu;
+	uint32_t ag = (((a >> 8) & 0x00ff00ffu) * g + ((b >> 8) & 0x00ff00ffu) * f) & 0xff00ff00u;
+	return rb | ag;
+}
+
+/* One canvas row scaled horizontally to the panel width. */
+static void
+sweet_fb_hscale(uint32_t *dst, const uint32_t *src, const uint16_t *x0, const uint8_t *fx, uint32_t w)
+{
+	for (uint32_t x = 0; x < w; x++) {
+		uint32_t i = x0[x];
+		dst[x] = fx[x] ? sweet_fb_lerp(src[i], src[i + 1], fx[x]) : src[i];
+	}
+}
