+/*
+ * sweet: sweetdrm's BOs are CPU-cacheable (the GPU's side is not) although
+ * GET_FLAGS says WC, and an idle BO is mapped without the kernel's wait (the
+ * invalidate), so lines the CPU fetched while the GPU wrote could be read, or
+ * merged into a partial write and cleaned over the GPU's data at the next
+ * submit. Invalidate the BO before the CPU uses it. Shared BOs (imports)
+ * always reach sweetdrm's GEM_CPU_PREP, which waits and invalidates.
+ */
+void sweetdrm_cpu_access(void *addr, uint64_t size);
+
+int
+fd_bo_cpu_prep(struct fd_bo *bo, struct fd_pipe *pipe, uint32_t op)
+{
+   int ret = bo_cpu_prep(bo, pipe, op);
+
+   if (ret == 0 && (op & (FD_BO_PREP_READ | FD_BO_PREP_WRITE)) &&
+       !(bo->alloc_flags & (FD_BO_SHARED | _FD_BO_NOSYNC | FD_BO_NOMAP))) {
+      void *map = fd_bo_map(bo);
+      if (map)
+         sweetdrm_cpu_access(map, fd_bo_size(bo));
+   }
+
+   return ret;
+}
