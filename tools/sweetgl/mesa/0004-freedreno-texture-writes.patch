+/*
+ * sweet: sweetdrm cleans the CPU caches of the BOs a submit uses that the CPU
+ * may have written. Tell it when a texture's BO is written through a map, so
+ * it can skip textures the CPU has not written since their last clean.
+ * Buffers are not reported (persistent maps, uploads): those stay cleaned.
+ */
+void sweetdrm_bo_cpu_write(uint32_t handle, int persistent);
+
+static void
+sweet_report_write(struct fd_resource *rsc, unsigned usage)
+{
+   if ((usage & PIPE_MAP_WRITE) && rsc->b.b.target != PIPE_BUFFER && rsc->bo)
+      sweetdrm_bo_cpu_write(fd_bo_handle(rsc->bo), !!(usage & PIPE_MAP_PERSISTENT));
+}
